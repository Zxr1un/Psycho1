                        <TranslateTransform x:Name="bounceTransform10"/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

        </Canvas>

        <!-- Кнопка закрытия с плавным скруглением -->
        <Button x:Name="CloseButton" Content="×" Width="35" Height="35" 
                HorizontalAlignment="Right" VerticalAlignment="Top" 
                Margin="0,15,15,0" Click="CloseButton_Click"
                Background="#FF6B6B6B" Foreground="White" 
                FontSize="18" FontWeight="Bold" FontFamily="Arial">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="17.5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="0"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFE53935"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFC62828"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>